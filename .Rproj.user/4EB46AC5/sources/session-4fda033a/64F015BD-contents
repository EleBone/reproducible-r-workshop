# Sample data with mixed case letters
df <- data.frame(genes = c("BRCA1", "TP53", "GAPDH", "actb", "brca2", "GATA3"),treatment = c("Placebo", "DrugA", "drugB", "PLACEBO", "DrugB", "PlaceBo"))

# Convert the 'genes' and 'treatment' columns to a factor
df$genes_factor <- factor(df$genes)

# Show the default factor levels
levels(df$genes_factor)

# Set a new locale
Sys.setlocale("LC_COLLATE", "C")

# Convert 'genes' column to a factor again and check levels
df$genes_factor_C <- factor(df$genes)

# Check the factor levels with the new locale
levels(df$genes_factor_C)

# Remember to reset to your system default locale
Sys.setlocale("LC_COLLATE", "")
